<?xml version="1.0" encoding="utf-8"?>
<!-- File actions bottom sheet (Figma "More" 10:3012): file header + two rows of actions. Action
     cells are 84 apart like Figma; the rows start 14 left of the content edge so each 56 tile
     lines up with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/_16dp"
    android:paddingEnd="@dimen/_16dp"
    android:paddingBottom="@dimen/_24dp">

    <View
        android:layout_width="@dimen/_36dp"
        android:layout_height="@dimen/_4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_12dp"
        android:background="@drawable/bg_ds_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24dp"
        android:background="@drawable/bg_ds_file_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12dp"
        android:paddingTop="@dimen/_8dp"
        android:paddingEnd="@dimen/_8dp"
        android:paddingBottom="@dimen/_8dp">

        <FrameLayout
            android:layout_width="@dimen/_48dp"
            android:layout_height="@dimen/_52dp"
            android:background="@drawable/bg_ds_file_icon"
            android:backgroundTint="@color/ds_surface">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/_23dp"
                android:layout_height="@dimen/_23dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_ds_file_pdf" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.DS.Subtitle1"
                tools:text="Project brief.xlsx" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.DS.Body3"
                tools:text="2.4 MB  ·  Today, 09:15" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/star"
            android:layout_width="@dimen/_40dp"
            android:layout_height="@dimen/_40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/doc_star"
            android:scaleType="center"
            tools:src="@drawable/ic_ds_star_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_minus14dp"
        android:layout_marginTop="@dimen/_20dp"
        android:clipChildren="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/action_share"
            layout="@layout/view_sheet_action" />

        <include
            android:id="@+id/action_rename"
            layout="@layout/view_sheet_action" />

        <include
            android:id="@+id/action_details"
            layout="@layout/view_sheet_action" />

        <include
            android:id="@+id/action_move"
            layout="@layout/view_sheet_action" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_minus14dp"
        android:layout_marginTop="@dimen/_16dp"
        android:clipChildren="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/action_delete"
            layout="@layout/view_sheet_action" />

        <include
            android:id="@+id/action_copy"
            layout="@layout/view_sheet_action" />
    </LinearLayout>
</LinearLayout>
