<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/hero"
        layout="@layout/view_tool_hero" />

    <LinearLayout
        android:id="@+id/options"
        style="@style/ClearPDF.CardContent"
        android:layout_marginTop="@dimen/section_gap"
        android:background="@drawable/bg_card"
        android:visibility="gone">

        <include
            android:id="@+id/header"
            layout="@layout/view_section_header" />

        <TextView
            android:id="@+id/source_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption"
            android:textSize="13sp" />

        <include
            android:id="@+id/position"
            layout="@layout/view_segment_two" />

        <include
            android:id="@+id/include_total"
            layout="@layout/view_setting_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/run"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:minHeight="52dp"
        android:visibility="gone" />

    <include
        android:id="@+id/status"
        layout="@layout/view_tool_status" />

    <include
        android:id="@+id/open_output"
        layout="@layout/view_tool_open_output" />
</LinearLayout>
