<?xml version="1.0" encoding="utf-8"?>
<!-- A picked file in an ordered list: icon, name, move up / down, remove. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_picture_as_pdf" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/app_text"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/up"
        style="@style/Widget.ClearPDF.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/move_up"
        app:icon="@drawable/ic_arrow_upward"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/down"
        style="@style/Widget.ClearPDF.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/move_down"
        app:icon="@drawable/ic_arrow_downward"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/remove"
        style="@style/Widget.ClearPDF.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/recents_remove"
        app:icon="@drawable/ic_close"
        app:iconSize="18dp"
        app:iconTint="@color/accent_red" />
</LinearLayout>
