<?xml version="1.0" encoding="utf-8"?>
<!-- PDF to Word: pick a PDF, convert on device, open the .docx. Same frame as the other tools. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/hero"
        layout="@layout/view_tool_hero" />

    <include
        android:id="@+id/file"
        layout="@layout/view_tool_file" />

    <LinearLayout
        android:id="@+id/note"
        style="@style/ClearPDF.CardContent"
        android:layout_marginTop="@dimen/_16dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_20dp"
            android:layout_height="@dimen/_20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            app:tint="@color/app_text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_weight="1"
            android:text="@string/pdf_to_word_note"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/convert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:minHeight="@dimen/_52dp"
        android:visibility="gone"
        app:icon="@drawable/ic_format_word" />

    <include
        android:id="@+id/status"
        layout="@layout/view_tool_status" />

    <include
        android:id="@+id/open_output"
        layout="@layout/view_tool_open_output" />
</LinearLayout>
