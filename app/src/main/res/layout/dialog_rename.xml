<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_24dp"
    android:paddingTop="@dimen/_8dp"
    android:paddingEnd="@dimen/_24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/name_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/doc_rename_hint"
        app:boxCornerRadiusBottomEnd="@dimen/_12dp"
        app:boxCornerRadiusBottomStart="@dimen/_12dp"
        app:boxCornerRadiusTopEnd="@dimen/_12dp"
        app:boxCornerRadiusTopStart="@dimen/_12dp"
        app:boxStrokeColor="@color/ds_primary"
        app:hintTextColor="@color/ds_primary"
        app:suffixTextAppearance="@style/TextAppearance.DS.Body2"
        app:suffixTextColor="@color/ds_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.DS.Body2" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
