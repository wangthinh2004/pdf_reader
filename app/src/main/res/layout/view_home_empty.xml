<?xml version="1.0" encoding="utf-8"?>
<!-- Home empty state (Figma 10:1729). Also used for "allow access" and "no matches" with other
     texts; the illustration is built from views the way the Figma layers are. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/_14dp"
    android:paddingTop="@dimen/_96dp"
    android:paddingEnd="@dimen/_14dp"
    android:paddingBottom="@dimen/_24dp">

    <FrameLayout
        android:layout_width="@dimen/_120dp"
        android:layout_height="@dimen/_104dp"
        android:importantForAccessibility="noHideDescendants">

        <View
            android:layout_width="@dimen/_104dp"
            android:layout_height="@dimen/_86dp"
            android:layout_marginStart="@dimen/_8dp"
            android:layout_marginTop="@dimen/_12dp"
            android:background="@drawable/bg_ds_illus_backdrop" />

        <View
            android:layout_width="@dimen/_43dp"
            android:layout_height="@dimen/_63dp"
            android:layout_marginStart="@dimen/_55dp"
            android:layout_marginTop="@dimen/_23dp"
            android:background="@drawable/bg_ds_illus_companion"
            android:rotation="12" />

        <LinearLayout
            android:layout_width="@dimen/_55dp"
            android:layout_height="@dimen/_76dp"
            android:layout_marginStart="@dimen/_29dp"
            android:layout_marginTop="@dimen/_8dp"
            android:background="@drawable/bg_ds_illus_page"
            android:orientation="vertical"
            android:padding="@dimen/_11dp">

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_ds_empty_file_text"
                app:tint="@color/ds_illus_page_border" />

            <View
                android:layout_width="@dimen/_31dp"
                android:layout_height="@dimen/_2dp"
                android:layout_marginTop="@dimen/_7dp"
                android:background="@drawable/bg_ds_illus_line" />

            <View
                android:layout_width="@dimen/_26dp"
                android:layout_height="@dimen/_2dp"
                android:layout_marginTop="@dimen/_7dp"
                android:background="@drawable/bg_ds_illus_line" />

            <View
                android:layout_width="@dimen/_29dp"
                android:layout_height="@dimen/_2dp"
                android:layout_marginTop="@dimen/_7dp"
                android:background="@drawable/bg_ds_illus_line" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/_27dp"
            android:layout_height="@dimen/_27dp"
            android:layout_marginStart="@dimen/_68dp"
            android:layout_marginTop="@dimen/_65dp"
            android:background="@drawable/bg_ds_illus_badge">

            <ImageView
                android:layout_width="@dimen/_16dp"
                android:layout_height="@dimen/_16dp"
                android:layout_gravity="center"
                android:rotation="45"
                android:src="@drawable/ic_ds_empty_plus" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12dp"
        android:gravity="center"
        android:text="@string/home_empty_title"
        android:textAppearance="@style/TextAppearance.DS.Heading3" />

    <TextView
        android:id="@+id/body"
        android:layout_width="@dimen/_251dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8dp"
        android:gravity="center"
        android:text="@string/home_empty_body"
        android:textAppearance="@style/TextAppearance.DS.Body2"
        android:textColor="@color/ds_text_secondary"
        app:lineHeight="@dimen/_22sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cta"
        style="@style/Widget.DS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48dp"
        android:layout_marginTop="@dimen/_24dp"
        android:text="@string/home_empty_cta" />
</LinearLayout>
