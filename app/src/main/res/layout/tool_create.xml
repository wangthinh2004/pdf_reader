<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/hero"
        layout="@layout/view_tool_hero" />

    <!-- Mode: from images / blank pages / typed text. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:orientation="vertical"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <!-- From images -->
    <LinearLayout
        android:id="@+id/images_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            style="@style/ClearPDF.CardContent"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/draft_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ClearPDF.BodyStrong"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_scan"
                    app:icon="@drawable/ic_camera_alt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_images"
                    style="@style/Widget.ClearPDF.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/images_add"
                    app:icon="@drawable/ic_upload_file" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/images_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="@string/create_scan_or_images_hint"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/draft_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Blank pages -->
    <LinearLayout
        android:id="@+id/blank_group"
        style="@style/ClearPDF.CardContent"
        android:layout_marginTop="@dimen/section_gap"
        android:background="@drawable/bg_card"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_blank_title"
            android:textAppearance="@style/TextAppearance.ClearPDF.BodyStrong"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/create_blank_subtitle"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fewer"
                style="@style/Widget.ClearPDF.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:backgroundTint="@color/app_surface_variant"
                app:icon="@drawable/ic_remove" />

            <TextView
                android:id="@+id/blank_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/app_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/more"
                style="@style/Widget.ClearPDF.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_add_circle_outline"
                app:iconTint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Typed text -->
    <LinearLayout
        android:id="@+id/text_group"
        style="@style/ClearPDF.CardContent"
        android:layout_marginTop="@dimen/section_gap"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_text_title"
            android:textAppearance="@style/TextAppearance.ClearPDF.BodyStrong"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/create_text_subtitle"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_layout"
            style="@style/Widget.ClearPDF.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="4sp"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/char_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:minHeight="56dp"
        app:icon="@drawable/ic_note_add" />

    <include
        android:id="@+id/status"
        layout="@layout/view_tool_status" />

    <include
        android:id="@+id/open_output"
        layout="@layout/view_tool_open_output" />
</LinearLayout>
