<?xml version="1.0" encoding="utf-8"?>
<!-- Home grid card (Figma "Document card" 19:705): 150 high; tinted preview with the first page
     peeking out, then name + more, kind badge · size (+ star), date. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_6dp"
    android:paddingEnd="@dimen/_6dp"
    android:paddingBottom="@dimen/_12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_150dp"
        android:checkable="true"
        app:cardBackgroundColor="@color/ds_surface"
        app:cardCornerRadius="@dimen/_12dp"
        app:cardElevation="0dp"
        app:checkedIcon="@drawable/ic_ds_check_square"
        app:checkedIconTint="@color/ds_primary"
        app:rippleColor="@color/ds_divider"
        app:strokeColor="@color/ds_card_stroke"
        app:strokeWidth="@dimen/_1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_74dp"
                android:clipChildren="true"
                android:paddingTop="@dimen/_8dp"
                tools:background="@color/ds_kind_pdf_bg">

                <FrameLayout
                    android:layout_width="@dimen/_122dp"
                    android:layout_height="@dimen/_86dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_ds_thumb_page">

                    <ImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="matrix"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/kind_icon"
                        android:layout_width="@dimen/_23dp"
                        android:layout_height="@dimen/_23dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_22dp"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_ds_file_pdf" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_10dp"
                android:paddingTop="@dimen/_8dp"
                android:paddingEnd="@dimen/_4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_semibold"
                        android:maxLines="1"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="@dimen/_12sp"
                        tools:text="Brand guidelines.pdf" />

                    <ImageButton
                        android:id="@+id/more"
                        android:layout_width="@dimen/_24dp"
                        android:layout_height="@dimen/_24dp"
                        android:layout_marginStart="@dimen/_1dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/doc_more"
                        android:scaleType="center"
                        android:src="@drawable/ic_ds_more_vert_small"
                        app:tint="@color/ds_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.DS.Badge"
                        tools:text="PDF"
                        tools:textColor="@color/ds_kind_pdf" />

                    <TextView
                        android:id="@+id/size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5dp"
                        android:maxLines="1"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="@dimen/_12sp"
                        tools:text="· 3.2 MB" />

                    <ImageView
                        android:id="@+id/star"
                        android:layout_width="@dimen/_11dp"
                        android:layout_height="@dimen/_11dp"
                        android:layout_marginStart="@dimen/_5dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_star_small"
                        app:tint="@color/ds_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.DS.Caption"
                    tools:text="Oct 3, 2026" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
