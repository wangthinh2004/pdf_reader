<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom of the Recents card: the long-press hint when the list is collapsed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/section_gap"
    android:background="@drawable/bg_card_bottom"
    android:minHeight="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="@string/recents_long_press_hint"
        android:textColor="@color/app_text_secondary"
        android:textSize="11sp" />
</FrameLayout>
