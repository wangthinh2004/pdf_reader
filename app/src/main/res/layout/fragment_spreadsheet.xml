<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/app_text"
        app:titleTextAppearance="@style/TextAppearance.ClearPDF.ToolbarTitle" />

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_close"
            style="@style/Widget.ClearPDF.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/close"
            app:icon="@drawable/ic_arrow_back" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/viewer_find_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_text_secondary" />

        <TextView
            android:id="@+id/search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_prev"
            style="@style/Widget.ClearPDF.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/previous"
            app:icon="@drawable/ic_keyboard_arrow_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_next"
            style="@style/Widget.ClearPDF.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/next"
            app:icon="@drawable/ic_keyboard_arrow_down" />
    </LinearLayout>

    <!-- Formula bar: the selected cell's reference and content. -->
    <LinearLayout
        android:id="@+id/formula_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/cell_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/app_divider" />

        <EditText
            android:id="@+id/cell_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/sheet_formula_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="3"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cell_copy"
            style="@style/Widget.ClearPDF.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/copy"
            app:icon="@drawable/ic_content_copy"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cell_commit"
            style="@style/Widget.ClearPDF.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/save"
            android:visibility="gone"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/accent_blue" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/grid_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp">

            <com.chethan616.clearpdf.ui.fragment.sheet.SheetGridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/accent_blue" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Formatting tools (edit mode) -->
    <HorizontalScrollView
        android:id="@+id/edit_tools_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/edit_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <!-- Sheet tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/sheets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:tabIndicatorColor="@color/accent_blue"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/accent_blue"
        app:tabTextAppearance="@style/TextAppearance.ClearPDF.Body"
        app:tabTextColor="@color/app_text_secondary" />
</LinearLayout>
