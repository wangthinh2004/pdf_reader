<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/app_text"
        app:title="@string/scan_title"
        app:titleTextAppearance="@style/TextAppearance.ClearPDF.ToolbarTitle" />

    <include
        android:id="@+id/error"
        layout="@layout/view_tool_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding" />

    <!-- Nothing scanned yet -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                style="@style/ClearPDF.CardContent"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:padding="32dp">

                <FrameLayout
                    android:id="@+id/scan_icon_tile"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_rounded">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_document_scanner"
                        app:tint="@color/tool_scan" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/scan_title"
                    android:textColor="@color/app_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/scan_description"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="52dp"
                    android:text="@string/scan_document"
                    app:backgroundTint="@color/tool_scan"
                    app:icon="@drawable/ic_camera_alt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gallery"
                    style="@style/Widget.ClearPDF.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="52dp"
                    android:text="@string/import_gallery"
                    app:icon="@drawable/ic_photo_library" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/features"
                style="@style/ClearPDF.CardContent"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_features"
                    android:textAppearance="@style/TextAppearance.ClearPDF.SectionTitle"
                    android:textSize="@dimen/_16sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Scanned pages -->
    <LinearLayout
        android:id="@+id/pages_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/page_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.ClearPDF.BodyStrong"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_more"
                style="@style/Widget.ClearPDF.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/scan_more"
                app:icon="@drawable/ic_document_scanner"
                app:iconTint="@color/tool_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_gallery"
                style="@style/Widget.ClearPDF.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/add_from_gallery"
                app:icon="@drawable/ic_photo_library"
                app:iconTint="@color/tool_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_all"
                style="@style/Widget.ClearPDF.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/clear_all"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/accent_red" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter"
                android:textAppearance="@style/TextAppearance.ClearPDF.BodyStrong"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:minHeight="56dp"
            android:text="@string/save_as_pdf"
            app:backgroundTint="@color/tool_scan"
            app:icon="@drawable/ic_picture_as_pdf" />
    </LinearLayout>
</LinearLayout>
