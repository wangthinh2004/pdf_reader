<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/hero"
        layout="@layout/view_tool_hero" />

    <include
        android:id="@+id/file"
        layout="@layout/view_tool_file" />

    <LinearLayout
        android:id="@+id/options"
        style="@style/ClearPDF.CardContent"
        android:layout_marginTop="@dimen/section_gap"
        android:background="@drawable/bg_card"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/quality_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_high_quality" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_compression_quality"
                android:textAppearance="@style/TextAppearance.ClearPDF.SectionTitle"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/quality_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_small"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/quality_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="0"
            android:valueTo="1"
            app:labelBehavior="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_smaller_size"
                android:textAppearance="@style/TextAppearance.ClearPDF.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_higher_quality"
                android:textAppearance="@style/TextAppearance.ClearPDF.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/estimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.ClearPDF.Caption"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/compress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:minHeight="52dp"
        android:visibility="gone"
        app:icon="@drawable/ic_compress" />

    <include
        android:id="@+id/status"
        layout="@layout/view_tool_status" />

    <include
        android:id="@+id/open_output"
        layout="@layout/view_tool_open_output" />
</LinearLayout>
