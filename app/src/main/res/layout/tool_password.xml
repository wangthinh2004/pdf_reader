<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypt / decrypt: pick a PDF, enter a password (and confirm it when encrypting), save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/hero"
        layout="@layout/view_tool_hero" />

    <LinearLayout
        android:id="@+id/options"
        style="@style/ClearPDF.CardContent"
        android:layout_marginTop="@dimen/section_gap"
        android:background="@drawable/bg_card"
        android:visibility="gone">

        <TextView
            android:id="@+id/source_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ClearPDF.BodyStrong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_source"
            style="@style/Widget.ClearPDF.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/view_pdf"
            app:icon="@drawable/ic_open_in_new" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_layout"
            style="@style/Widget.ClearPDF.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirm_layout"
            style="@style/Widget.ClearPDF.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp" />
    </LinearLayout>

    <include
        android:id="@+id/status"
        layout="@layout/view_tool_status" />

    <include
        android:id="@+id/open_output"
        layout="@layout/view_tool_open_output" />
</LinearLayout>
