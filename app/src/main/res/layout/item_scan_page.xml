<?xml version="1.0" encoding="utf-8"?>
<!-- A scanned page: image with the filter applied, page number, remove button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:cardBackgroundColor="@color/app_surface_variant"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/app_divider"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/number"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/tool_scan"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/remove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#CC000000"
            android:contentDescription="@string/remove_page"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
