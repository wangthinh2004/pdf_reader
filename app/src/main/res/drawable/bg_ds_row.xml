<?xml version="1.0" encoding="utf-8"?>
<!-- File row: white, radius 12, primary-container wash while selected, ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ds_divider">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/_12dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_primary_container" />
                    <corners android:radius="@dimen/_12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_surface" />
                    <corners android:radius="@dimen/_12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
