<?xml version="1.0" encoding="utf-8"?>
<!-- Every screen of the app. The start destination is chosen at runtime (onboarding or home). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/onboarding"
        android:name="com.chethan616.clearpdf.ui.fragment.onboarding.OnboardingFragment">
    </fragment>

    <fragment
        android:id="@+id/home"
        android:name="com.chethan616.clearpdf.ui.fragment.home.HomeFragment">
    </fragment>

    <fragment
        android:id="@+id/tools"
        android:name="com.chethan616.clearpdf.ui.fragment.tools.ToolsFragment">
    </fragment>

    <fragment
        android:id="@+id/settings"
        android:name="com.chethan616.clearpdf.ui.fragment.settings.SettingsFragment">
    </fragment>

    <fragment
        android:id="@+id/scan"
        android:name="com.chethan616.clearpdf.ui.fragment.scan.ScanFragment">
    </fragment>

    <fragment
        android:id="@+id/pdf_viewer"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="pdf_viewer" app:argType="string" />
        <argument android:name="uri" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/spreadsheet"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="spreadsheet" app:argType="string" />
        <argument android:name="uri" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/image_editor"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="image_editor" app:argType="string" />
        <argument android:name="uri" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/merge_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.MergePdfFragment">
    </fragment>

    <fragment
        android:id="@+id/split_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.SplitPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/compress_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.CompressPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/create_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.CreatePdfFragment">
    </fragment>

    <fragment
        android:id="@+id/organize_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.PageOrganizerFragment">
    </fragment>

    <fragment
        android:id="@+id/extract_text"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.ExtractTextFragment">
    </fragment>

    <fragment
        android:id="@+id/images_to_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.ImagesToPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/decrypt_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.DecryptPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/encrypt_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.EncryptPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/pdf_to_images"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.PdfToImagesFragment">
    </fragment>

    <fragment
        android:id="@+id/watermark_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.WatermarkPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/extract_pages"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.ExtractPagesFragment">
    </fragment>

    <fragment
        android:id="@+id/page_numbers"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.PageNumbersFragment">
    </fragment>

    <fragment
        android:id="@+id/flatten_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.FlattenPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/image_tools"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.ImageToolsFragment">
    </fragment>

    <fragment
        android:id="@+id/html_to_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.HtmlToPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/fill_form"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.FillFormFragment">
    </fragment>
</navigation>
