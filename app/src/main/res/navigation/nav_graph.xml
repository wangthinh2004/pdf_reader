<?xml version="1.0" encoding="utf-8"?>
<!-- Every screen of the app. The start destination is chosen at runtime (onboarding or home). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/onboarding"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="onboarding" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/home"
        android:name="com.chethan616.clearpdf.ui.fragment.home.HomeFragment">
    </fragment>

    <fragment
        android:id="@+id/tools"
        android:name="com.chethan616.clearpdf.ui.fragment.tools.ToolsFragment">
    </fragment>

    <fragment
        android:id="@+id/settings"
        android:name="com.chethan616.clearpdf.ui.fragment.settings.SettingsFragment">
    </fragment>

    <fragment
        android:id="@+id/scan"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="scan_document" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/pdf_viewer"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="pdf_viewer" app:argType="string" />
        <argument android:name="uri" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/spreadsheet"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="spreadsheet" app:argType="string" />
        <argument android:name="uri" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/image_editor"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="image_editor" app:argType="string" />
        <argument android:name="uri" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/merge_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="merge_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/split_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="split_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/compress_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.tool.CompressPdfFragment">
    </fragment>

    <fragment
        android:id="@+id/create_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="create_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/organize_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="organize_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/extract_text"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="extract_text" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/images_to_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="images_to_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/decrypt_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="decrypt_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/encrypt_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="encrypt_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/pdf_to_images"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="pdf_to_images" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/watermark_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="watermark_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/extract_pages"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="extract_pages" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/page_numbers"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="page_numbers" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/flatten_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="flatten_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/image_tools"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="image_tools" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/html_to_pdf"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="html_to_pdf" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/fill_form"
        android:name="com.chethan616.clearpdf.ui.fragment.ComposeBridgeFragment">
        <argument android:name="route" android:defaultValue="fill_form" app:argType="string" />
    </fragment>
</navigation>
